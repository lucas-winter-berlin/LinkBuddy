# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-dein-bot-token
OWNER_USER_ID=123456789

# Database – lokal SQLite (Default), in Produktion Postgres/Supabase
# DATABASE_URL=sqlite+aiosqlite:///./linkbuddy.db
# DATABASE_URL=postgresql://user:pass@host:5432/linkbuddy

# Gemini (optional – ohne Key laeuft Auto-Tagging rein heuristisch)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-flash-latest

# Bot-Einstellungen
BOT_TIMEZONE=Europe/Berlin
EXPORT_DAY=6
EXPORT_TIME=18:00
DEPLOYMENT_ENV=development
LOG_LEVEL=INFO
